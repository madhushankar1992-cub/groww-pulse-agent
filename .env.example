# Copy this file to .env and put real keys there. Keep this example blank.
# Setup checklist: Docs/input.md (section 2). Do not store keys in Markdown files.
# Groq commands use config/settings.groq.example.yaml.
GROQ_API_KEY=
PULSE_DRAFT_RECIPIENT=

# Direct publication through gmail-docs-mcp (fill in .env only; never commit values).
MCP_AUTH_TOKEN=
PULSE_GOOGLE_DOC_ID=
GMAIL_DOCS_MCP_URL=https://gmail-docs-mcp.vercel.app/mcp
